# Trained weights - large, kept out of git. Back these up outside the repo;
# retraining is hours of GPU time.
models/*.pkl
models/*.pt

# Ultralytics training output
runs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
backend/.venv/

# Flutter
app/build/
app/.dart_tool/
app/.flutter-plugins*
app/android/.gradle/
# absolute SDK paths, machine-specific and regenerated by flutter
app/android/local.properties
*.iml

# Internal docs - not shared. 07-deployment.md carries server topology, firewall rules and
# the fact that the API is unauthenticated; 06-decisions.md carries the same in passing.
# Note this only bites on a fresh repo: once a file is tracked, gitignore stops applying to
# it, so verify with "git ls-files docs/" after any git init.
docs/

# Written by Claude, in a register that does not match the rest of the project. Kept on disk
# because they are useful to work from, out of the repo because the code is what gets read.
CHANGELOG.md
START-HERE.md
deploy/README.md
backend/README.md
app/README.md
notebooks/*_cell.py

# Working notes. Same reason docs/ is excluded: it carries the server layout and states
# plainly that the API's only protection is a key extractable from the APK.
notes.md

# Release signing. The keystore itself lives outside the repo entirely; this catches a copy
# taken into it by accident. key.properties holds the passwords in plain text.
app/android/key.properties
*.jks
*.keystore

# Kaggle credentials - never commit
kaggle.json
.env
